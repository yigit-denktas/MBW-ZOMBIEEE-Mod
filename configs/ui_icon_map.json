  "sourceCatalogue": "reference/FREE_ASSET_SOURCES.md",
  "binaryAssetsCommitted": false,
  "wiredToRuntime": false,
  "notes": [
    "Definitions-only proposal. No atlas, BRF, presentation, DDS or font file exists yet.",
    "No binary data is committed; icon svg/png/dds files must not be added until the licence-cleared asset PR.",
    "slot.source.primary is the intended canonical art; slot.source.fallback is used only if the primary is rejected in visual QA.",
    "Attribution strings are generated from this file; every CC BY slot requires author + licence + page URL.",
    "task-64 addendum: environment/cover + survivor cosmetic/armour/face/hair slots and an additive reticle candidate; visual validation requires in-game screenshots (plan docs/ICON_MAPPING.md §10) and no native reticle resize is claimed.",
    "Project-authored reticle/overlay concept: reference/RETICLE_OVERLAY_CONCEPT.md (variants A/B/C; additive overlay only; no native resize claim; screenshots by D required)."
  ],
  "atlas": {
    "runtimeFormat": "dds",
    "compression": "DXT5",
    "masterSizePx": 64,
    "deliveredSizesPx": [
      64,
      32,
      16
    ],
    "feedbackSizesPx": [
      24,
      32
    ],
    "pages": [
      256,
      512
    ],
    "paddingPx": 2,
    "foreground": "#FFFFFF",
    "background": "transparent",
    "tintMode": "runtime overlay_set_color",
    "naming": "ui_zdr_<slot>",
    "maxSlotsPerPage": 64,
    "textFallbackRequired": true,
    "note": "DXT3/DXT5 for alpha textures and dimensions multiple of four are Warband pipeline requirements (reference/FREE_ASSET_SOURCES.md 2.2). Minimum-size QA is required before approval."
  },
